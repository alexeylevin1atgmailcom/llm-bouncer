{
  "name": "llm-bouncer",
  "version": "0.1.0",
  "description": "Detect and block AI/LLM security vulnerabilities in chatbot input and output — prompt injection, PII, secrets, unsafe output, and more.",
  "license": "Apache-2.0",
  "author": "",
  "keywords": [
    "llm",
    "ai",
    "security",
    "prompt-injection",
    "guardrails",
    "chatbot",
    "owasp",
    "pii",
    "firewall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeylevin1atgmailcom/llm-bouncer.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "homepage": "https://github.com/alexeylevin1atgmailcom/llm-bouncer#readme",
  "bugs": {
    "url": "https://github.com/alexeylevin1atgmailcom/llm-bouncer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
